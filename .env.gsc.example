# Google Search Console — geneboyle.com
# https://search.google.com/search-console

# Preferred property: https://www.geneboyle.com (Domain property also OK)

# --- Method A (recommended): HTML meta tag ---
# GSC → Settings → Ownership verification → HTML tag
# Paste only the content= value (not the full <meta> tag)
GOOGLE_SITE_VERIFICATION=your_google_verification_token_here

# Optional public alias (same token)
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=your_google_verification_token_here

# --- Method B: HTML file ---
# GSC → HTML file method. Filename looks like googleXXXXXXXX.html
GOOGLE_SITE_VERIFICATION_FILE=googleXXXXXXXX.html
GOOGLE_SITE_VERIFICATION_CONTENT=google-site-verification: googleXXXXXXXX.html

# Canonical site URL used by sitemap.xml + robots.txt
NEXT_PUBLIC_SITE_URL=https://www.geneboyle.com
