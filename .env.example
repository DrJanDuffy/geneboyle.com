# OpenRouter API Configuration
# Get your API key from https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Next.js Environment
NODE_ENV=development

# Site Configuration (canonical www for GSC + sitemap)
NEXT_PUBLIC_SITE_URL=https://www.geneboyle.com

# Google Search Console (see .env.gsc.example and docs/google-search-console.md)
# GOOGLE_SITE_VERIFICATION=your_google_verification_token_here
